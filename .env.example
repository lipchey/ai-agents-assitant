ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Tavily is primary web search; DuckDuckGo fallback needs no key.
TAVILY_API_KEY=

OPENCLAW_GATEWAY_TOKEN=
# Override gateway/runtime endpoints; defaults target the local gateway.
OPENCLAW_GATEWAY_URL=
OPENCLAW_BASE_URL=
# Override gateway config/state locations; defaults live alongside the project.
OPENCLAW_CONFIG_PATH=
OPENCLAW_STATE_DIR=

# Soft USD cost ceiling for one run; defaults to 1.00 when unset.
AGENT_COST_BUDGET_USD=
# Truthy enables guarded patch writes; empty leaves patch application off.
AGENT_APPLY_PATCHES=
# HITL defaults to interactive on a TTY; 0/false/no/off forces auto-abort.
AGENT_HITL=
# Diagnostic logging threshold: debug, info, warn, or error. Defaults to info.
AGENT_LOG_LEVEL=
# Diagnostic logging format: text or json. Defaults to text.
AGENT_LOG_FORMAT=
