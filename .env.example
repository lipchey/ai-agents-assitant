ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
# Optional. Set to 1/true to let the agent write verified patches to disk
# (guarded applyPatches stage). Defaults off — drafts are returned, not applied.
AGENT_APPLY_PATCHES=
# Optional. Human-in-the-loop for swarm environment failures. Defaults ON: prompts
# on the terminal when interactive, and degrades to graceful auto-abort on a
# non-TTY. Set to a falsey value (0/false/no/off) to force auto-abort everywhere.
AGENT_HITL=
