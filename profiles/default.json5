{
  // Default profile: a byte-stable replica of the pre-R2 modelForRole switch on the
  // OpenClaw transport, expressed in the tier format (model-tiers design). `tuning`
  // is intentionally omitted so every cap defaults to src/consts/tuning.ts. Selecting
  // a different profile is what changes behavior; this one must not. `model` strings
  // double as the model-pricing.json cost keys.
  name: "default",
  description: "Byte-stable replica of the pre-profile model cascade on the OpenClaw transport.",
  transport: { default: "openclaw" },
  // Tier bindings: the cascade as four codenames. Roles resolve to a tier via
  // DEFAULT_ROLE_TIER (src/models/resolve.ts) unless overridden under `roles`.
  tiers: {
    // worker: cheap, deterministic routing/compression — DeepSeek V4 Flash, temp 0,
    // thinking off. Default tier for router / firewall / worker.
    worker: {
      provider: "deepseek",
      model: "deepseek/deepseek-v4-flash",
      params: { temperature: 0, thinking: "disabled" },
    },
    // skilled: implementation — Claude Sonnet, temperature 0.2. Default tier for coder.
    skilled: {
      provider: "anthropic",
      model: "anthropic/claude-sonnet-4-6",
      params: { temperature: 0.2 },
    },
    // adviser: strong architecture/review — Claude Opus, adaptive thinking, no explicit
    // temperature. Default tier for reasoner / architect / critic.
    adviser: {
      provider: "anthropic",
      model: "anthropic/claude-opus-4-8",
      params: { thinking: "adaptive", reasoningEffort: "high" },
    },
    // frontier: top tier behind escalation gates — Claude Opus. Default tier for sme.
    frontier: {
      provider: "anthropic",
      model: "anthropic/claude-opus-4-8",
      params: { thinking: "adaptive", reasoningEffort: "high" },
    },
  },
  // Per-role overrides (full bindings, bypassing the tier layer) that preserve the
  // pre-R6a cascade: a low-cost reasoner and a cross-family critic.
  roles: {
    // First-pass architecture/review: DeepSeek V4 Pro with thinking enabled.
    reasoner: {
      provider: "deepseek",
      model: "deepseek/deepseek-v4-pro",
      params: { temperature: 0.2, thinking: "enabled", reasoningEffort: "high" },
    },
    // Cross-family review: GPT, temperature 0.1.
    critic: {
      provider: "openai",
      model: "openai/gpt-5.5",
      params: { temperature: 0.1 },
    },
  },
  budget: { costBudgetUsd: 1 },
  prompts: {
    // Replicates the pre-R5 hardcoded cascade prose for this profile's bindings.
    cascadeNote: "Cheap models (DeepSeek Flash) route and compress; a low-cost frontier model (DeepSeek V4 Pro) does first-pass architecture and critique; strong models (Claude Opus, GPT-5.5) run ONLY when high-risk or low-confidence signals demand them.",
  },
}
