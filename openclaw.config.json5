{
  gateway: {
    mode: "local",
    bind: "loopback",
    auth: {
      mode: "token",
      token: "dev_token_123",
    },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  agents: {
    defaults: {
      workspace: ".",
      model: {
        primary: "anthropic/claude-sonnet-4-6",
        fallbacks: ["deepseek/deepseek-v4-flash"],
      },
      models: {
        "anthropic/claude-opus-4-8": { alias: "Opus" },
        "anthropic/claude-sonnet-4-6": { alias: "Sonnet" },
        "openai/gpt-5.5": { alias: "GPT Critic" },
        "deepseek/deepseek-v4-pro": { alias: "DeepSeek Frontier" },
        "deepseek/deepseek-v4-flash": { alias: "DeepSeek Fast" },
      },
    },
    list: [
      {
        id: "main",
        default: true,
      },
      {
        id: "strong-reasoning",
        agentDir: ".openclaw_state/agents/main/agent",
        thinkingDefault: "adaptive",
        reasoningDefault: "off",
      },
    ],
  },
  plugins: {
    entries: {
      // Primary web search provider. Drives the dedicated `tavily_search` tool
      // (rich mode) used as the primary path in src/tools/openclaw.ts.
      tavily: {
        enabled: true,
        config: {
          webSearch: {
            // apiKey resolves from TAVILY_API_KEY in the Gateway env if omitted.
            baseUrl: "https://api.tavily.com",
          },
        },
      },
      // NOTE: the fallback provider is DuckDuckGo (key-free, no account, no
      // geo-restriction — Brave's API dashboard is geo-blocked in some regions).
      // It is a bundled provider that needs no plugin entry or API key; it is
      // selected via tools.web.search.provider below.
    },
  },
  tools: {
    profile: "coding",
    exec: {
      host: "gateway",
      timeoutSec: 1800,
    },
    web: {
      search: {
        enabled: true,
        // Pin the generic web_search tool to DuckDuckGo: it is the FALLBACK tier.
        // The Tavily primary is invoked separately via the `tavily_search` tool
        // (see runWebLookupWithFallback in src/tools/openclaw.ts).
        provider: "duckduckgo",
        maxResults: 8,
        timeoutSeconds: 30,
      },
    },
  },
}
