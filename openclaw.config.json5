{
  gateway: {
    mode: "local",
    bind: "loopback",
    auth: {
      mode: "token",
      token: "dev_token_123",
    },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  agents: {
    defaults: {
      workspace: ".",
      model: {
        primary: "anthropic/claude-sonnet-4-6",
        fallbacks: ["deepseek/deepseek-v4-flash"],
      },
      models: {
        "anthropic/claude-opus-4-8": { alias: "Opus" },
        "anthropic/claude-sonnet-4-6": { alias: "Sonnet" },
        "openai/gpt-5.5": { alias: "GPT Critic" },
        "deepseek/deepseek-v4-pro": { alias: "DeepSeek Frontier" },
        "deepseek/deepseek-v4-flash": { alias: "DeepSeek Fast" },
      },
    },
    list: [
      {
        id: "main",
        default: true,
      },
      {
        /* No agentDir override: OpenClaw auto-derives a unique dir per agent.
           Sharing main's agentDir collides on auth/session state and is rejected
           by the gateway. Credentials come from env API keys, not a shared dir. */
        id: "strong-reasoning",
        thinkingDefault: "adaptive",
        reasoningDefault: "off",
      },
    ],
  },
  plugins: {
    entries: {
      /* Tavily is the primary path through the dedicated tavily_search tool. */
      tavily: {
        enabled: true,
        config: {
          webSearch: {
            /* apiKey resolves from TAVILY_API_KEY in the Gateway env if omitted. */
            baseUrl: "https://api.tavily.com",
          },
        },
      },
      /* DuckDuckGo is the bundled key-free fallback; Brave API is geo-blocked in some regions. */
    },
  },
  tools: {
    profile: "coding",
    exec: {
      host: "gateway",
      timeoutSec: 1800,
    },
    web: {
      search: {
        enabled: true,
        /* Generic web_search is only the DuckDuckGo fallback tier. */
        provider: "duckduckgo",
        maxResults: 8,
        timeoutSeconds: 30,
      },
    },
  },
}
